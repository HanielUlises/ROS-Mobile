<?xml version="1.0"?>
<!--
  Basic differential-drive UGV for the multi-robot SLAM testbed (TT 2026-B193).

  The model is deliberately minimal: chassis + two driven wheels + caster + 2D
  lidar. Every link/joint name is prefixed and every ROS interface is pushed
  into a namespace so that N identical robots can coexist in one Gazebo world
  and one global /tf tree without frame collisions.

  Args:
    namespace : ROS namespace for this robot's topics (e.g. robot1)
    prefix    : TF frame prefix, normally "<namespace>/"
-->
<robot name="ugv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="namespace" default="robot1"/>
  <xacro:arg name="prefix" default="robot1/"/>

  <xacro:property name="ns" value="$(arg namespace)"/>
  <xacro:property name="pf" value="$(arg prefix)"/>

  <!-- Geometry -->
  <xacro:property name="base_x" value="0.35"/>
  <xacro:property name="base_y" value="0.28"/>
  <xacro:property name="base_z" value="0.12"/>
  <xacro:property name="base_mass" value="6.0"/>

  <xacro:property name="wheel_radius" value="0.070"/>
  <xacro:property name="wheel_width" value="0.040"/>
  <xacro:property name="wheel_mass" value="0.4"/>
  <xacro:property name="wheel_separation" value="0.30"/>
  <xacro:property name="wheel_xoff" value="0.08"/>

  <xacro:property name="caster_radius" value="0.030"/>
  <xacro:property name="caster_xoff" value="-0.12"/>

  <!-- base_footprint sits on the ground plane; chassis floats above it -->
  <xacro:property name="base_zoff" value="${wheel_radius}"/>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0.0"
               izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+l*l)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${m*(3*r*r+l*l)/12.0}" iyz="0.0"
               izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5.0}" ixy="0.0" ixz="0.0"
               iyy="${2*m*r*r/5.0}" iyz="0.0"
               izz="${2*m*r*r/5.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ================= links ================= -->

  <link name="${pf}base_footprint"/>

  <link name="${pf}base_link">
    <visual>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
      <material name="chassis"><color rgba="0.15 0.35 0.60 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_x}" y="${base_y}" z="${base_z}"/>
  </link>

  <joint name="${pf}base_joint" type="fixed">
    <parent link="${pf}base_footprint"/>
    <child link="${pf}base_link"/>
    <origin xyz="0 0 ${base_zoff}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="wheel" params="side reflect">
    <link name="${pf}${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
    </link>

    <joint name="${pf}${side}_wheel_joint" type="continuous">
      <parent link="${pf}base_link"/>
      <child link="${pf}${side}_wheel_link"/>
      <origin xyz="${wheel_xoff} ${reflect*wheel_separation/2.0} ${-base_zoff+wheel_radius}"
              rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${pf}${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <xacro:wheel side="left"  reflect="1"/>
  <xacro:wheel side="right" reflect="-1"/>

  <link name="${pf}caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="caster"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:sphere_inertia m="0.2" r="${caster_radius}"/>
  </link>

  <joint name="${pf}caster_joint" type="fixed">
    <parent link="${pf}base_link"/>
    <child link="${pf}caster_link"/>
    <origin xyz="${caster_xoff} 0 ${-base_zoff+caster_radius}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="${pf}caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <link name="${pf}base_scan">
    <visual>
      <geometry><cylinder radius="0.035" length="0.045"/></geometry>
      <material name="lidar"><color rgba="0.8 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.035" length="0.045"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.12" r="0.035" l="0.045"/>
  </link>

  <joint name="${pf}scan_joint" type="fixed">
    <parent link="${pf}base_link"/>
    <child link="${pf}base_scan"/>
    <origin xyz="0.10 0 ${base_z/2.0+0.025}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="${pf}base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- ================= gazebo plugins ================= -->

  <!-- 2D lidar. Plain CPU ray (not gpu_ray) so the testbed runs headless and
       on machines without a usable GL context. -->
  <gazebo reference="${pf}base_scan">
    <material>Gazebo/Red</material>
    <sensor name="${ns}_lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <!-- 15 Hz rather than the more usual 10: the dominant source of scan
           matching error here is in-place rotation, and the angular step
           between consecutive scans falls proportionally with the rate. -->
      <update_rate>15.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.1415926</min_angle>
            <max_angle>3.1415926</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>8.0</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="${ns}_lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/${ns}</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>${pf}base_scan</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Differential drive. Publishes odom + the odom->base_footprint TF on the
       global /tf (tf2 broadcasters always use the absolute topic), which is why
       every frame carries the ${pf} prefix. -->
  <gazebo>
    <plugin name="${ns}_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/${ns}</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>${pf}left_wheel_joint</left_joint>
      <right_joint>${pf}right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${2*wheel_radius}</wheel_diameter>
      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>1.5</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>${pf}odom</odometry_frame>
      <robot_base_frame>${pf}base_footprint</robot_base_frame>
      <!-- 0 = ENCODER: dead-reckon from the wheel joints, starting at identity
           at the spawn pose. Must not be 1 (WORLD): that publishes the absolute
           Gazebo pose as odometry, which would anchor every agent's map frame at
           the world origin instead of at its own start, and would also hand the
           SLAM front end drift-free odometry it has no business having. -->
      <odometry_source>0</odometry_source>
    </plugin>

    <plugin name="${ns}_joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/${ns}</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>${pf}left_wheel_joint</joint_name>
      <joint_name>${pf}right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
