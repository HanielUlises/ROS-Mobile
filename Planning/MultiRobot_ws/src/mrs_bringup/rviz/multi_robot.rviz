Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 100; 100; 100
    - Class: rviz_default_plugins/Map
      Name: Merged Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Draw Behind: false
      Alpha: 0.9
    - Class: rviz_default_plugins/Map
      Name: robot1 Map
      Enabled: false
      Topic:
        Value: /robot1/map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Draw Behind: true
      Alpha: 0.7
    - Class: rviz_default_plugins/Map
      Name: robot2 Map
      Enabled: false
      Topic:
        Value: /robot2/map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Draw Behind: true
      Alpha: 0.7
    - Class: rviz_default_plugins/LaserScan
      Name: robot1 Scan
      Enabled: true
      Topic:
        Value: /robot1/scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.04
      Style: Flat Squares
      Color: 0; 200; 255
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/LaserScan
      Name: robot2 Scan
      Enabled: true
      Topic:
        Value: /robot2/scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.04
      Style: Flat Squares
      Color: 255; 170; 0
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.4
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDownOrtho
      Angle: 0
      Scale: 55
      Target Frame: map
      X: 0
      Y: 0
Window Geometry:
  Height: 900
  Width: 1500
  Displays:
    collapsed: false
