<?xml version="1.0"?>
<package format="3">
  <name>warehouse_bringup</name>
  <version>1.0.0</version>
  <description>
    Bring-up for the PlanSys2 warehouse showcase: the launch file that puts a
    fleet of TurtleBot3 Waffles in the AWS RoboMaker small warehouse under
    PlanSys2, the mission controller that poses the problem and follows the
    plan, and the fleet monitor that records what the plan cost.
  </description>
  <maintainer email="hanielulises@gmail.com">Haniel Ulises</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>plansys2_domain_expert</depend>
  <depend>plansys2_executor</depend>
  <depend>plansys2_msgs</depend>
  <depend>plansys2_planner</depend>
  <depend>plansys2_problem_expert</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>yaml-cpp</depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>plansys2_bringup</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>warehouse_actions</exec_depend>
  <exec_depend>warehouse_planning</exec_depend>
  <exec_depend>aws_robomaker_small_warehouse_world</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
